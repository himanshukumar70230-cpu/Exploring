# Bidline API environment template.
# Copy to .env for local development: cp .env.example .env
# On Render, set these in the service's Environment tab instead of committing a file.

# development | production. Production refuses AUTH_DEV_MODE=true.
APP_ENV=development
PORT=8080
DATABASE_PATH=./data/bidline.db
FRONTEND_URL=http://localhost:3000

# --- Clerk -----------------------------------------------------------------
# Both halves of the key pair are required for real authentication.
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_ISSUER=
CLERK_JWKS_URL=

# --- Local fallback auth (development only) --------------------------------
AUTH_DEV_MODE=false
DEV_AUTH_SECRET=change-me-before-enabling-dev-auth
DEV_AUTH_EMAIL=demo@bidline.dev

# --- Gemini ----------------------------------------------------------------
# Without a key the agents fall back to deterministic local reasoning.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite

# --- PayPal ----------------------------------------------------------------
# mock runs the full escrow lifecycle without contacting PayPal.
# sandbox/live require a client id, secret, and webhook id.
PAYPAL_MODE=mock
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_RETURN_URL=http://localhost:3000/payments/paypal/return
PAYPAL_CANCEL_URL=http://localhost:3000/deals

# Platform fee in basis points. 150 = 1.50%.
PLATFORM_FEE_BPS=150
